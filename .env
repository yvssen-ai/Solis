# Solis — Supabase connection.
#
# Both of these values are public by design. The publishable key identifies the
# project and nothing else: it carries no privileges of its own, and every table
# it can reach is behind row level security. It is shipped to every browser that
# loads the site, so there is nothing to leak by committing it here — and having
# it in the repo means a fresh clone or a Vercel build works with no setup.
#
# The secret / service_role key is the one that must never appear in this file,
# in any VITE_ variable, or anywhere else in this repo. Vite inlines every VITE_
# variable into the JS bundle.
#
# To point the site at a different Supabase project, override these in the host's
# environment (Vercel → Settings → Environment Variables) or in `.env.local`,
# which git ignores.

VITE_SUPABASE_URL=https://qhlhquuevohnhploucnp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OWYnnQe5f_t1qnkdq3NQVw_a0s0d08n
